# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Native projects are generated from app.json by `expo prebuild`, so they are
# build output rather than source. Re-run prebuild after changing any native
# config (icon, scheme, orientation, plugins) — with these folders present,
# app.json no longer drives the build on its own.
/android
/ios

# Gradle output from local Expo modules
modules/*/android/build/
